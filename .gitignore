# Falling Fury — .gitignore

# Build directories
build*/
cmake-build-*/
bin/
lib/
out/
.build/
DerivedData/
*.xcarchive/
*.xcresult/
*.ipa
*.dSYM/
Pods/

# Generated Capacitor copies (source of truth is apps/web/site)
apps/ios/ios/App/App/public/
apps/android/android/app/src/main/assets/public/
apps/ios/ios/App/App/capacitor.config.json
apps/ios/ios/App/App/config.xml
apps/android/android/app/src/main/assets/capacitor.config.json
apps/android/android/app/src/main/assets/capacitor.plugins.json

# Vendored SFML docs/templates (~13 MB) — not needed to build; keep local copies
third_party/sfml-macos/doc/
third_party/sfml-macos/templates/

# CMake generated
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
*.cmake
!CMakeLists.txt
Testing/
CTestTestfile.cmake
compile_commands.json
.cache/

# IDE files
.vscode/
.idea/
.fleet/
*.code-workspace
.vs/
*.sln
*.vcxproj*
.swiftpm/
xcuserdata/
*.xcuserstate

# Compiled objects
*.d
*.slo
*.lo
*.o
*.obj
*.elf

# Precompiled headers
*.gch
*.pch

# Dynamic libraries
*.so
*.dylib
*.dll

# Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Desktop.ini

# Legacy / docs (removed from repo)
legacy/
docs/*
!docs/appstore/
!docs/playstore/
!docs/AI_HANDOFF.md

# Runtime data / logs
apps/native/data/data.txt
apps/native/data/leaderboard.txt
apps/native/data/*.tmp
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local tooling caches
.gradle/
.kotlin/

# Backup files
*.bak
*.backup
*.old
*.swp
*~

# Signing credentials — never commit
*.jks
*.keystore
keystore.properties
*.p12
*.p8
*.cer
*.mobileprovision
*.provisionprofile

# Environment secrets
.env
.env.*
!.env.example
